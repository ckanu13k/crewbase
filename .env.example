# Copy to .env.local. With NONE of these set, the app runs in demo mode with sample data.

# Public URL of the deployed app (used in texted links and Twilio signature checks)
APP_URL=https://your-app.vercel.app

# --- Supabase (turns off demo mode) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Comma-separated emails that sign in as recruiters/staff
ADMIN_EMAILS=
# Older name, still honored (treated as admin):
STAFF_EMAILS=you@example.com

# --- Claude (profile extraction + card photo reading) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# "on" = Claude rewrites gap explanations per job view (one extra call each)
AI_EXPLAIN=off

# --- Twilio (SMS, WhatsApp, voice) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
# or, without a Messaging Service:
TWILIO_FROM_NUMBER=
NEXT_PUBLIC_SMS_NUMBER=(713) 555-0100
NEXT_PUBLIC_VOICE_NUMBER=(713) 555-0101

# --- Stripe (placement invoices) ---
STRIPE_SECRET_KEY=

# --- Cron (Vercel sends this as a Bearer token) ---
CRON_SECRET=

# Background checks / drug screens (optional). Without these, screening runs in manual mode:
# workers authorize in the app, staff order in their provider's portal and record the outcome.
CHECKR_API_KEY=
CHECKR_PACKAGE_BACKGROUND=
CHECKR_PACKAGE_DRUG=
# Optional: webhook signing key if different from the API key. Webhook URL: {APP_URL}/api/screening/checkr
CHECKR_WEBHOOK_SECRET=

# Email (job alerts, employer notices, hiring-manager invites). Use the same Resend account as
# Supabase's custom SMTP so sign-in emails reach real people.
RESEND_API_KEY=
EMAIL_FROM=CrewPass <hello@yourdomain.com>
# Stripe webhook (marks invoices paid): {APP_URL}/api/stripe/webhook, event invoice.paid
STRIPE_WEBHOOK_SECRET=

# Temp-crew payroll partner (employer-of-record / embedded payroll). CrewPass computes hours, overtime,
# per diem and early pay; the partner withholds taxes, files W-2s and moves the money. Until these are set,
# next-day/instant payouts stay "pending" and the founder settles them from Admin → Payroll.
PAYROLL_PROVIDER=
PAYROLL_API_KEY=
